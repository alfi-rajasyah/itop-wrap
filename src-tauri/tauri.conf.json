{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iTop Wrap",
  "version": "1.0.2",
  "identifier": "io.github.alfi-rajasyah.itopwrap",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "iTop Wrap",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "copyright": "iTop Wrap, a client for iTop. Not affiliated with Combodo.",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
