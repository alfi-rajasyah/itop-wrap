{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main, New Ticket, Resolve and Settings windows: the three app commands, the snapshot event, title-bar dragging",
  "windows": [
    "main",
    "new-ticket",
    "resolve",
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-get-snapshot",
    "allow-dispatch",
    "allow-open-url"
  ]
}
